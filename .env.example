# Copy this file to .env and fill in real values.
# Environment variables are NOT auto-loaded by Prisma/Node -- diagnostic
# scripts must be run with: npx tsx --env-file=.env script.mjs

# PostgreSQL connection string (this project uses Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
# Generate a secret with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Resend (sends verification/reset/invite emails)
RESEND_API_KEY=

URL=http://localhost:3000

# Cloudinary (file/image uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google Gemini (AI question generation)
GEMINI_API_KEY=
